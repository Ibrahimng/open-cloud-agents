# Maintainer: Ibrahim Jimoh <Ibrahimng@users.noreply.github.com>
pkgname=ocagents
pkgver=1.3.0
pkgrel=0
pkgdesc="Universal CLI and specialist agents for Cloud Architecture, DevSecOps, SRE, and FinOps"
url="https://ibrahimng.github.io/open-cloud-agents/"
arch="noarch"
license="Apache-2.0"
depends="python3 git"
source="https://github.com/open-cloud-agents/ocagents/archive/refs/tags/v${pkgver}.tar.gz"

package() {
    mkdir -p "$pkgdir/usr/share/open-cloud-agents"
    cp -r "$builddir/agents" "$pkgdir/usr/share/open-cloud-agents/"
    cp -r "$builddir/skills" "$pkgdir/usr/share/open-cloud-agents/"
    cp -r "$builddir/rules" "$pkgdir/usr/share/open-cloud-agents/"
    cp -r "$builddir/scripts" "$pkgdir/usr/share/open-cloud-agents/"
    cp -r "$builddir/src" "$pkgdir/usr/share/open-cloud-agents/"

    mkdir -p "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/ocagents"
#!/usr/bin/env bash
export OCAGENTS_HOME="/usr/share/open-cloud-agents"
exec python3 "$OCAGENTS_HOME/src/ocagents/cli.py" "$@"
EOF
    chmod +x "$pkgdir/usr/bin/ocagents"
    ln -s /usr/bin/ocagents "$pkgdir/usr/bin/oca"
}

