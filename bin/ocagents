#!/usr/bin/env bash
# Open Cloud Agents: Universal CLI Launcher (ocagents)
# Version: 1.3.0
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Resolve CLI entrypoint
if [ -f "$REPO_ROOT/src/ocagents/cli.py" ]; then
    CLI_ENTRY="$REPO_ROOT/src/ocagents/cli.py"
    export OCAGENTS_HOME="${OCAGENTS_HOME:-$REPO_ROOT}"
elif [ -d "$HOME/.open-cloud-agents" ] && [ -f "$HOME/.open-cloud-agents/src/ocagents/cli.py" ]; then
    CLI_ENTRY="$HOME/.open-cloud-agents/src/ocagents/cli.py"
    export OCAGENTS_HOME="${OCAGENTS_HOME:-$HOME/.open-cloud-agents}"
elif [ -n "$OCAGENTS_HOME" ] && [ -f "$OCAGENTS_HOME/src/ocagents/cli.py" ]; then
    CLI_ENTRY="$OCAGENTS_HOME/src/ocagents/cli.py"
else
    echo "❌ Error: Open Cloud Agents assets not found." >&2
    echo "Please run: curl -fsSL https://ibrahimng.github.io/open-cloud-agents/install.sh | bash" >&2
    exit 1
fi

# Detect python3 runtime
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$CLI_ENTRY" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$CLI_ENTRY" "$@"
else
    echo "❌ Error: Python 3.9+ is required to run Open Cloud Agents (ocagents)." >&2
    exit 1
fi
