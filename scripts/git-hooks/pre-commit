#!/usr/bin/env bash
# ==============================================================================
# Git Hook Target: Local Pre-Commit Quality Gate
# Orchestrates: Security Compliance Commander (SCC) AI Validation Framework
# ==============================================================================

set -euo pipefail

TARGET_ORCHESTRATOR="skills/security/compliance/ai-governance-audit/scripts/run_ai_security_pipeline.sh"

echo -e "\n\033[0;34m[*] Pre-Commit: Commencing validation via Security Compliance Commander...\033[0;0m"

if [[ -f "$TARGET_ORCHESTRATOR" ]]; then
    # Ensure script execution bit is flipped locally
    chmod +x "$TARGET_ORCHESTRATOR"
    
